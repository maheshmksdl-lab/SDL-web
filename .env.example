# ─────────────────────────────────────────────────────────────────────────────
# SDL Web — copy to .env and fill in. Never commit .env.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Anything secret must
# NOT carry that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── CMS connection ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Server-only. API key for a read-only `preview@` user, used exclusively for draft
# reads when draftMode is enabled. Never expose to the client.
CMS_API_KEY=

# ── Shared secrets — must MATCH the values in cms/.env ────────────────────────
REVALIDATE_SECRET=
PREVIEW_SECRET=

# ── Site identity ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gates robots.txt: anything other than "production" is noindex.
NEXT_PUBLIC_ENV=development

# ── Forms ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only — never prefix with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# ── Visual parity harness ────────────────────────────────────────────────────
# Static server serving the sdl-2.0 design files, for design-fidelity comparison.
PARITY_DESIGN_URL=http://localhost:4001
PARITY_TARGET_URL=http://localhost:3000

NODE_ENV=development
